# Runtime
PORT=3000
NODE_ENV=development
PUBLIC_WEBHOOK_URL=https://example.com/api/monday/webhook
COMPANY_NAME=Hilos y Algodón, S.A.
INCLUDE_AUTHORIZATION_LINES=true

# monday.com credentials (never commit real values)
MONDAY_API_TOKEN=
MONDAY_SIGNING_SECRET=
# Required fallback for a board webhook created without an app-signed JWT.
# Add the same value as ?secret=... to PUBLIC_WEBHOOK_URL.
MONDAY_WEBHOOK_SECRET=
MONDAY_REQUIRE_JWT=false
MONDAY_API_VERSION=2026-10

# Board and trigger
MONDAY_BOARD_ID=18433758498
MONDAY_TRIGGER_COLUMN_ID=color_mm7r9b1w
MONDAY_TRIGGER_LABEL=Aprobado para generar
MONDAY_REPORT_PDF_COLUMN_ID=file_mm7rp1y1

# Main item columns
MONDAY_COLLABORATOR_COLUMN_ID=person
MONDAY_DEPARTMENT_COLUMN_ID=
MONDAY_PERIOD_START_COLUMN_ID=date_mm7r76eb
MONDAY_PERIOD_END_COLUMN_ID=date4
MONDAY_TOTAL_KM_COLUMN_ID=lookup_mm7rbkya
MONDAY_DECLARED_KM_COLUMN_ID=numeric_mm7rg95t
MONDAY_RATE_COLUMN_ID=numeric_mm7rt81x
MONDAY_EXCHANGE_RATE_COLUMN_ID=numeric_mm7rpc7x
MONDAY_CONFIRMATION_COLUMN_ID=boolean_mm7ry62j
MONDAY_APPROVAL_COLUMN_ID=color_mm7r9b1w

# Subitem columns
MONDAY_TRIP_DATE_COLUMN_ID=date0
MONDAY_TRIP_END_COLUMN_ID=text_mm7rn7he
MONDAY_TRIP_DISTANCE_COLUMN_ID=numeric_mm7r864e
MONDAY_TRIP_PROOF_COLUMN_ID=file_mm7r1zdy

# The fuel rate is a fixed business rule in src/config.js: USD 0.25/km.
# It is intentionally not configurable from monday.com, the form, or environment variables.
FUEL_RATE_CURRENCY=USD
REIMBURSEMENT_CURRENCY=GTQ

# Network and attachment limits
MONDAY_REQUEST_TIMEOUT_MS=15000
MONDAY_MAX_RETRIES=3
MAX_ATTACHMENTS=40
MAX_ATTACHMENT_BYTES=15728640
MAX_TOTAL_ATTACHMENT_BYTES=104857600
